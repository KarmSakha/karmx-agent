{
  "name": "karmx_custom",
  "engine": "openai",
  "display_name": "OpenAI-compatible",
  "description": "Any OpenAI-compatible endpoint you configure. Set KARMX_BASE_URL and KARMX_API_KEY, then pick any model name.",
  "api_key_env": "KARMX_API_KEY",
  "base_url": "${KARMX_BASE_URL}/v1/chat/completions",
  "env_vars": [
    {
      "name": "KARMX_BASE_URL",
      "required": true,
      "secret": false,
      "primary": true,
      "description": "Base URL of your OpenAI-compatible server (OpenAI, Azure, OpenRouter, vLLM, Ollama, LM Studio, ...)"
    },
    {
      "name": "KARMX_API_KEY",
      "required": false,
      "secret": true,
      "description": "API key if your endpoint requires one"
    }
  ],
  "dynamic_models": true,
  "models": [],
  "supports_streaming": true,
  "requires_auth": true,
  "skip_canonical_filtering": true,
  "setup": {
    "category": "model",
    "setup_method": "config_fields",
    "group": "additional",
    "field_overrides": [
      {
        "key": "KARMX_BASE_URL",
        "label": "Base URL",
        "placeholder": "https://api.openai.com"
      },
      {
        "key": "KARMX_API_KEY",
        "label": "API key",
        "placeholder": "sk-..."
      }
    ]
  }
}
